# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# MongoDB connection string (Atlas or local), e.g.
# mongodb://127.0.0.1:27017/listy
MONGODB_URI=

# Secret used to sign login sessions. At least 32 characters, random.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everyone out.
SESSION_SECRET=

# Live updates (Pusher Channels). Optional: without these the app works,
# just without live updates. Get them from pusher.com → Channels → your
# app → App Keys. Only the KEY and CLUSTER are public (NEXT_PUBLIC_*);
# PUSHER_SECRET must never reach the browser.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
