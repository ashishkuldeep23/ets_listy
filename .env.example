# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# MongoDB connection string (Atlas or local), e.g.
# mongodb://127.0.0.1:27017/listy
MONGODB_URI=

# Secret used to sign login sessions. At least 32 characters, random.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everyone out.
SESSION_SECRET=

# Live updates (Pusher Channels). Optional: without these the app works,
# just without live updates. Get them from pusher.com → Channels → your
# app → App Keys. Only the KEY and CLUSTER are public (NEXT_PUBLIC_*);
# PUSHER_SECRET must never reach the browser.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Google login. Optional: without these the Google button stays hidden. From
# console.cloud.google.com → Google Auth Platform → Clients.
# GOOGLE_CLIENT_SECRET must never reach the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# true: only "Continue with Google" (password login and signup are refused).
# false or empty: email + password, plus Google if it is set up above.
ONLY_LOGIN_WITH_GOOGLE=

# Reminder notifications (Web Push). Optional: without these, reminders can
# still be set and added to a calendar, but no notification is sent.
# Generate the key pair once with: npx web-push generate-vapid-keys
# Changing the keys stops notifications until people set a reminder again.
# NEXT_PUBLIC_* is built into the page, so rebuild after changing it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who push services can contact about problems, e.g. mailto:you@example.com
VAPID_SUBJECT=

# Password for the job that sends due reminders (GET /api/cron/reminders, every
# minute, header "Authorization: Bearer <this>"). Generate it like SESSION_SECRET.
CRON_SECRET=
